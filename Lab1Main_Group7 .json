   "source": [
    "import csv \n",
    "from exceptions import TextFormatException, MissingValueException, MeasurementUnitException\n",
    "\n",
    "\n",
    "import csv\n",
    "from exceptions import TextFormatException, MissingValueException, MeasurementUnitException\n",
    "\n",
    "\n",
    "def parse_row(row):\n",
    "    if len(row) != 5:\n",
    "        raise TextFormatException(\"Wrong number of values\")\n",
    "\n",
    "    if \"\" in row:\n",
    "        raise MissingValueException(\"A value is missing\")\n",
    "\n",
    "    try:\n",
    "        exam_id = int(row[0])\n",
    "        weight = float(row[3])\n",
    "        height = float(row[4])\n",
    "    except ValueError:\n",
    "        raise TextFormatException(\"Invalid number format\")\n",
    "\n",
    "    if height > 3:\n",
    "        raise MeasurementUnitException(\"Height is in feet\")\n",
    "\n",
    "    return [exam_id, row[1], row[2], weight, height]\n",
    "\n",
    "\n",
    "def calculate_bmi(weight, height):\n",
    "    return weight / (height ** 2)\n",
    "\n",
    "\n",
    "def main():\n",
    "    with open(\"data.csv\", \"r\") as file:\n",
    "        reader = csv.reader(file)\n",
    "        next(reader)\n",
    "\n",
    "        with open(\"bmi_output.csv\", \"w\") as output_file:\n",
    "            writer = csv.writer(output_file)\n",
    "            writer.writerow([\"Exam ID\", \"BMI\"])\n",
    "\n",
    "            for row in reader:\n",
    "                try:\n",
    "                    exam_id, date, name, weight, height = parse_row(row)\n",
    "\n",
    "                    bmi = calculate_bmi(weight, height)\n",
    "\n",
    "                    writer.writerow([exam_id, f\"{bmi:.2f}\"])\n",
    "\n",
    "                except TextFormatException as e:\n",
    "                    print(f\"Exam ID {row[0]}: {e}\")\n",
    "\n",
    "                except MissingValueException as e:\n",
    "                    print(f\"Exam ID {row[0]}: {e}\")\n",
    "\n",
    "                except MeasurementUnitException as e:\n",
    "                    print(f\"Exam ID {row[0]}: {e}\")\n",
    "\n",
    "\n",
    "main()"
   ]
  },

import numpy as np

def load_data(filename):
    # Load the CSV file
    data = np.genfromtxt(
        filename,
        delimiter=",",
        names=True,
        dtype=None,
        encoding="utf-8"
    )

    # Extract the four columns
    date = data["Date"]
    openp = data["Open"]
    closep = data["Close"]
    vol = data["Volume"]

    print("Task 1 - Loaded Stock Data")
    print("Dates:", date)
    print("Opening Prices:", openp)
    print("Closing Prices:", closep)
    print("Trading Volumes:", vol)

    return date, openp, closep, vol, data


